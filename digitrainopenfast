# StockOpenerGUI.ps1 - Neon terminal GUI; persistent Firefox profile
# Each ticker: open Yahoo + Zacks + Finviz together in a new window (Yahoo focused)
# Uses the same 'StockOpener' Firefox profile every time; welcome suppressed

$ErrorActionPreference = 'Stop'

# Performance defaults for the digital rain UI
if ($null -eq $script:MaxRainStreams) { $script:MaxRainStreams = 24 }
if ($null -eq $script:PrefillVisible) { $script:PrefillVisible = $true }
# Allow streams to extend past left/right edges by this many pixels (global overscan)
if ($null -eq $script:HorizOverscan) { $script:HorizOverscan = 48 }
# Extra right/left-only column(s) and additional beyond-overscan shift
if ($null -eq $script:ExtraRightColumns) { $script:ExtraRightColumns = 1 }
if ($null -eq $script:RightEdgeExtra)   { $script:RightEdgeExtra   = 96 }
if ($null -eq $script:ExtraLeftColumns)  { $script:ExtraLeftColumns  = 1 }
if ($null -eq $script:LeftEdgeExtra)     { $script:LeftEdgeExtra     = 96 }
if ($null -eq $script:DeferTickerLoad)   { $script:DeferTickerLoad   = $true }

function Get-FirefoxPath {
  $candidates = @(
    "$env:ProgramFiles\Mozilla Firefox\firefox.exe",
    "$env:ProgramFiles(x86)\Mozilla Firefox\firefox.exe"
  )
  foreach ($p in $candidates) { if (Test-Path $p) { return $p } }
  throw "Firefox not found. Edit Get-FirefoxPath() to point to firefox.exe."
}

# 1) Locate Firefox
$Firefox = Get-FirefoxPath

# 2) Ensure StockOpener profile (fixed path so prefs persist)
$ProfileDir = Join-Path $env:APPDATA 'Mozilla\Firefox\Profiles\StockOpener'
if (-not (Test-Path $ProfileDir)) { New-Item -ItemType Directory -Path $ProfileDir -Force | Out-Null }
# Create profile only if not already registered in profiles.ini (faster startup)
$profilesIni = Join-Path $env:APPDATA 'Mozilla\Firefox\profiles.ini'
$hasStockProfile = $false
try {
  if (Test-Path $profilesIni) {
    $hasStockProfile = Select-String -Path $profilesIni -SimpleMatch -Pattern 'Name=StockOpener' -Quiet
  }
} catch {}
if (-not $hasStockProfile) {
  & $Firefox -CreateProfile "StockOpener $ProfileDir" | Out-Null
}

# 3) Enforce prefs: tab behavior + suppress welcome/first-run
$userJs = @"
user_pref("browser.link.open_newwindow", 3);
user_pref("browser.link.open_newwindow.restriction", 0);
// Keep additional tabs in background so Yahoo stays focused
user_pref("browser.tabs.loadInBackground", true);
user_pref("browser.tabs.loadDivertedInBackground", true);
// Append tabs at the end to preserve Yahoo, Zacks, Finviz order
user_pref("browser.tabs.insertRelatedAfterCurrent", false);
user_pref("browser.tabs.insertAfterCurrent", false);
// Tame first-run noise
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("browser.sessionstore.resume_from_crash", false);
// Suppress about:welcome and any first-run homepage overrides
user_pref("browser.aboutwelcome.enabled", false);
user_pref("trailhead.firstrun.didSeeAboutWelcome", true);
user_pref("startup.homepage_welcome_url", "");
user_pref("startup.homepage_welcome_url.additional", "");
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.startup.homepage", "about:blank");
user_pref("browser.startup.page", 1);
// Trust Windows cert store (prevents TLS issues with AV/proxies)
user_pref("security.enterprise_roots.enabled", true);
"@
# Write prefs only when changed to avoid unnecessary disk I/O
$userJsPath = Join-Path $ProfileDir 'user.js'
try {
  $existing = if (Test-Path $userJsPath) { Get-Content -Raw -LiteralPath $userJsPath -ErrorAction SilentlyContinue } else { $null }
  if ($existing -ne $userJs) {
    Set-Content -Encoding ASCII -Path $userJsPath -Value $userJs
  }
} catch {
  # Best-effort; ignore if unable to write
}

# 3.5) Ensure no other Firefox is running (we will start on first ticker)
function Ensure-StockOpenerInstance {
  while (Get-Process -Name firefox -ErrorAction SilentlyContinue) {
    $res = [System.Windows.MessageBox]::Show(
      "Please close ALL Firefox windows, then click OK to continue.",
      "Firefox is running",
      'OKCancel',
      'Warning'
    )
    if ($res -eq 'Cancel') { throw 'Canceled due to running Firefox processes.' }
  }
}

# Bring the just-opened Firefox window to the foreground
function Focus-FirefoxWindow([string]$Ticker) {
  try {
    $shell = New-Object -ComObject WScript.Shell
    for ($i = 0; $i -lt 15; $i++) {
      # Prefer matching the Yahoo title which starts with the ticker (e.g., "AAPL - ... - Yahoo Finance")
      if ($Ticker) {
        if ($shell.AppActivate($Ticker)) { return }
      }
      # Generic Firefox window title match
      if ($shell.AppActivate('Mozilla Firefox')) { return }
      if ($shell.AppActivate('Yahoo Finance')) { return }

      # Fallback: activate the main Firefox window by PID
      $proc = Get-Process -Name firefox -ErrorAction SilentlyContinue |
              Where-Object { $_.MainWindowHandle -ne 0 } |
              Select-Object -First 1
      if ($proc) {
        if ($shell.AppActivate([int]$proc.Id)) { return }
      }
      Start-Sleep -Milliseconds 150
    }
  } catch {}
}

# Win32 helpers to enumerate top-level windows and bring top Firefox window to front
function Ensure-Win32Helpers {
  if (-not ('Win32.NativeMethods' -as [type])) {
    Add-Type -Language CSharp -TypeDefinition @"
using System;
using System.Text;
using System.Runtime.InteropServices;

namespace Win32 {
  public static class NativeMethods {
    public delegate bool EnumWindowsProc(IntPtr hWnd, IntPtr lParam);
    [DllImport("user32.dll")] public static extern bool EnumWindows(EnumWindowsProc lpEnumFunc, IntPtr lParam);
    [DllImport("user32.dll")] public static extern bool IsWindowVisible(IntPtr hWnd);
    [DllImport("user32.dll", CharSet=CharSet.Unicode)] public static extern int GetWindowText(IntPtr hWnd, StringBuilder sb, int maxCount);
    [DllImport("user32.dll", CharSet=CharSet.Unicode)] public static extern int GetClassName(IntPtr hWnd, StringBuilder sb, int maxCount);
    [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr hWnd);
    [DllImport("user32.dll")] public static extern bool IsIconic(IntPtr hWnd);
    [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);
  }
}
"@
  }
}

function Get-FirefoxWindows {
  Ensure-Win32Helpers
  $handles = New-Object System.Collections.Generic.List[System.IntPtr]
  $cb = [Win32.NativeMethods+EnumWindowsProc]{ param([IntPtr]$h,[IntPtr]$p)
    if ([Win32.NativeMethods]::IsWindowVisible($h)) {
      $cls = New-Object System.Text.StringBuilder 256
      [void][Win32.NativeMethods]::GetClassName($h, $cls, $cls.Capacity)
      if ($cls.ToString() -eq 'MozillaWindowClass') { $handles.Add($h) }
    }
    return $true
  }
  [void][Win32.NativeMethods]::EnumWindows($cb, [IntPtr]::Zero)
  return $handles
}

function Focus-TopFirefoxWindow {
  try {
    Ensure-Win32Helpers
    $wins = Get-FirefoxWindows
    if ($wins.Count -gt 0) {
      $h = $wins[0]
      # Restore if minimized (SW_RESTORE = 9)
      if ([Win32.NativeMethods]::IsIconic($h)) { [void][Win32.NativeMethods]::ShowWindow($h, 9) }
      [void][Win32.NativeMethods]::SetForegroundWindow($h)
      return $true
    }
  } catch {}
  # Fallback to COM-based focus
  Focus-FirefoxWindow $null | Out-Null
  return $false
}

