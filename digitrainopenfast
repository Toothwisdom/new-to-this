function New-RandomChar {
  $chars = '01ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
  return $chars[(Get-Random -Minimum 0 -Maximum $chars.Length)]
}

function New-StreamText([int]$length) {
  $sb = New-Object System.Text.StringBuilder
  for ($i=0; $i -lt $length; $i++) {
    [void]$sb.Append((New-RandomChar))
    if ($i -lt $length-1) { [void]$sb.Append("`n") }
  }
  return $sb.ToString()
}

function Convert-CsvTextToTickers([string]$csv) {
  $result = New-Object System.Collections.Generic.List[string]
  if (-not $csv) { return @() }
  try {
    $rows = $csv | ConvertFrom-Csv
    foreach ($r in $rows) {
      $sym = $null
      foreach ($k in 'Symbol','Ticker','symbol','ticker','Code','code','SYM','sym') {
        if ($r.PSObject.Properties.Name -contains $k) { $sym = [string]$r.$k; break }
      }
      if (-not $sym) {
        # If CSV is single-column without header, treat the whole row text as symbol
        $text = ($r | Out-String).Trim()
        if ($text -and -not ($text -like '*=*')) { $sym = $text }
      }
      if ($sym) { $result.Add($sym.Trim().ToUpper()) }
    }
  } catch {}
  # Deduplicate and filter obvious junk
  return ($result | Where-Object { $_ -match '^[A-Z\.]\{1,6\}$' } | Select-Object -Unique)
}

function Convert-CsvTextToTickersFixed([string]$csv) {
  $result = New-Object System.Collections.Generic.List[string]
  if (-not $csv) { return @() }
  try {
    $rows = $csv | ConvertFrom-Csv
    foreach ($r in $rows) {
      $sym = $null
      foreach ($k in 'Symbol','Ticker','symbol','ticker','Code','code','SYM','sym') {
        if ($r.PSObject.Properties.Name -contains $k) { $sym = [string]$r.$k; break }
      }
      if (-not $sym) {
        $text = ($r | Out-String).Trim()
        if ($text -and -not ($text -like '*=*')) { $sym = $text }
      }
      if ($sym) { $result.Add($sym.Trim().ToUpper()) }
    }
  } catch {}
  return ($result | Where-Object { $_ -match '^[A-Z\.]{1,6}$' } | Select-Object -Unique)
}

function Load-Tickers {
  if ($script:Sp500Tickers -and $script:Sp500Tickers.Count -gt 0 -and
      $script:AllTickers  -and $script:AllTickers.Count  -gt 0) { return }

  # Fast-start path: use a small built-in list until full lists are loaded
  if ($script:DeferTickerLoad) {
    if (-not $script:Sp500Tickers -or $script:Sp500Tickers.Count -eq 0) {
      $script:Sp500Tickers = @('AAPL','MSFT','GOOGL','AMZN','NVDA','META','TSLA','BRK.B','UNH','XOM','JNJ','JPM','V','PG')
    }
    if (-not $script:AllTickers -or $script:AllTickers.Count -eq 0) {
      $script:AllTickers = $script:Sp500Tickers
    }
    $script:Tickers = ($script:Sp500Tickers + $script:AllTickers | Select-Object -Unique)
    return
  }

  $desktop = [Environment]::GetFolderPath('Desktop')
  $spPath  = Join-Path $desktop 'SP500.csv'
  $allPath = Join-Path $desktop 'all_us_stocks.csv'

  $sp  = @()
  $all = @()

  if (Test-Path $spPath)  { $sp  = Convert-CsvTextToTickersFixed (Get-Content -Raw -LiteralPath $spPath) }
  if (Test-Path $allPath) { $all = Convert-CsvTextToTickersFixed (Get-Content -Raw -LiteralPath $allPath) }

  # Fallback minimal list if files missing or empty
  if (-not $sp  -or $sp.Count  -lt 10) { $sp  = @('AAPL','MSFT','GOOGL','AMZN','NVDA','META','TSLA','BRK.B','UNH','XOM','JNJ','JPM','V','PG') }
  if (-not $all -or $all.Count -lt 10) { $all = @('AAPL','MSFT','GOOGL','AMZN','NVDA','META','TSLA','BRK.B','UNH','XOM','JNJ','JPM','V','PG') }

  $script:Sp500Tickers = $sp
  $script:AllTickers   = $all
  # Keep combined list for any other usage
  $script:Tickers = ($sp + $all | Select-Object -Unique)
}

function Get-RandomTicker {
  if (-not $script:Sp500Tickers -or -not $script:AllTickers) { Load-Tickers }
  if (($script:Sp500Tickers.Count -eq 0) -and ($script:AllTickers.Count -eq 0)) { return (New-RandomChar) }

  # 80% from SP500.csv, 20% from all_us_stocks.csv
  $pick = Get-Random -Minimum 0 -Maximum 100
  if ($script:Sp500Tickers.Count -eq 0) {
    return $script:AllTickers[(Get-Random -Minimum 0 -Maximum $script:AllTickers.Count)]
  } elseif ($script:AllTickers.Count -eq 0) {
    return $script:Sp500Tickers[(Get-Random -Minimum 0 -Maximum $script:Sp500Tickers.Count)]
  } elseif ($pick -lt 80) {
    return $script:Sp500Tickers[(Get-Random -Minimum 0 -Maximum $script:Sp500Tickers.Count)]
  } else {
    return $script:AllTickers[(Get-Random -Minimum 0 -Maximum $script:AllTickers.Count)]
  }
}

function New-StreamTickers([int]$length) {
  # Build a vertical stack of full tickers (one per line)
  Load-Tickers
  $sb = New-Object System.Text.StringBuilder
  for ($i=0; $i -lt $length; $i++) {
    [void]$sb.Append((Get-RandomTicker))
    if ($i -lt $length-1) { [void]$sb.Append("`n") }
  }
  return $sb.ToString()
}

function Init-DigitalRain {
  if (-not $DigitalRain) { return }
  $DigitalRain.Children.Clear()
  $script:RainStreams = @()

  $w = [double]$DigitalRain.ActualWidth
  $h = [double]$DigitalRain.ActualHeight
  if ($w -le 0) { $w = [double]$window.ActualWidth }
  if ($h -le 0) { $h = [double]$window.ActualHeight }
  if ($w -le 0 -or $h -le 0) { return }

  Load-Tickers
  $fontSize  = 16.0
  # Non-overlap, edge-aligned column layout
  $tickerMaxLen = 6.0
  $charFactor   = 0.62
  $lineH        = 18.0
  $maxScale        = 1.35
  $maxStreamWidth  = [double][Math]::Ceiling(($fontSize * $maxScale * $charFactor * $tickerMaxLen) + 8.0)
  $stepX           = [double]$maxStreamWidth
  $overscan         = [double]$script:HorizOverscan
  $extraRightCols   = [int]([Math]::Max(0, [int]$script:ExtraRightColumns))
  $rightEdgeExtra   = [double]$script:RightEdgeExtra
  $extraLeftCols    = [int]([Math]::Max(0, [int]$script:ExtraLeftColumns))
  $leftEdgeExtra    = [double]$script:LeftEdgeExtra
  # Compute base columns using overscan so base first/last columns can extend beyond edges
  $colsBase         = [int][Math]::Ceiling((($w + (2.0 * $overscan)) / $stepX))
  if ($colsBase -lt 1) { $colsBase = 1 }
  if ($script:MaxRainStreams -gt 0) {
    $maxBase = [int]$script:MaxRainStreams - $extraRightCols - $extraLeftCols
    if ($maxBase -lt 1) { $maxBase = 1 }
    if ($colsBase -gt $maxBase) { $colsBase = $maxBase }
  }
  $cols = [int]($colsBase + $extraLeftCols + $extraRightCols)

  for ($i=0; $i -lt $cols; $i++) {
    # Mixed lengths: most short, some long
    $lenPick = Get-Random -Minimum 0 -Maximum 100
    if ($lenPick -lt 70) {
      $len = Get-Random -Minimum 5 -Maximum 12
    } else {
      $len = Get-Random -Minimum 16 -Maximum 28
    }
    $tb    = New-Object System.Windows.Controls.TextBlock
    $tb.FontFamily = 'Consolas'
    $tb.FontSize   = $fontSize
    # Randomly enlarge some columns
    $sizeRoll = Get-Random -Minimum 0 -Maximum 100
    if ($sizeRoll -lt 20) {
      $tb.FontSize = [double]$fontSize * 1.35
    } elseif ($sizeRoll -lt 40) {
      $tb.FontSize = [double]$fontSize * 1.2
    }
    $tb.Foreground = $script:BrushDim
    # Optionally add neon glow around text for some columns (make it obvious)
    $glowRoll = Get-Random -Minimum 0 -Maximum 100
    if ($glowRoll -lt 25) {
      # Brighten the text itself when glowing
      $tb.Foreground = $script:BrushBright
      $glow = New-Object System.Windows.Media.Effects.DropShadowEffect
      $glow.BlurRadius   = (Get-Random -Minimum 14 -Maximum 24)
      $glow.ShadowDepth  = 0
      $glow.Color        = [System.Windows.Media.Color]([System.Windows.Media.ColorConverter]::ConvertFromString('#00FF66'))
      $glow.Opacity      = [double](Get-Random -Minimum 70 -Maximum 95) / 100.0
      try { $glow.RenderingBias = [System.Windows.Media.Effects.RenderingBias]::Performance } catch {}
      $tb.Effect         = $glow
    }
    $tb.Text       = (New-StreamTickers $len)
    $tb.TextAlignment = 'Left'

    # Fixed non-overlap placement using base index (ignores extra-left cells)
    $baseIndex = [int]($i - $extraLeftCols)
    $baseX = [double](-1.0 * $overscan + ($baseIndex * $stepX))
    $streamWidth = [double][Math]::Ceiling(($tb.FontSize * $charFactor * $tickerMaxLen) + 8.0)
    $candX = [double]($baseX + (($stepX - $streamWidth) / 2.0))

    $isExtraLeft  = ($i -lt $extraLeftCols)
    $isExtraRight = ($i -ge ($extraLeftCols + $colsBase))
    $isFirstBase  = ($baseIndex -eq 0)
    $isLastBase   = ($baseIndex -eq ($colsBase - 1))

    if     ($isExtraLeft)  { $candX = [double](-1.0 * ($streamWidth + $overscan + $leftEdgeExtra)) }
    elseif ($isFirstBase)  { $candX = 0.0 }
    elseif ($isExtraRight) { $candX = [double](($w - $streamWidth) + $overscan + $rightEdgeExtra) }
    elseif ($isLastBase)   { $candX = [double](($w - $streamWidth) + $overscan) }

    $minX = -1.0 * $overscan
    $maxX = [double](($w - $streamWidth) + $overscan)
    if ($isExtraRight) { $maxX = [double]($maxX + $rightEdgeExtra) }
    if ($isExtraLeft)  { $minX = [double]($minX - $leftEdgeExtra - $streamWidth) }
    if ($candX -lt $minX) { $candX = $minX }
    if ($candX -gt $maxX) { $candX = $maxX }
    [System.Windows.Controls.Canvas]::SetLeft($tb, [double]$candX)

    # Initial placement: optionally prefill across the visible area so screen looks busy immediately
    $lineHScale   = [double]$lineH / [double]$fontSize
    $streamLineH  = [double]$tb.FontSize * $lineHScale
    $streamHeight = [double]$streamLineH * [double]$len
    if ($script:PrefillVisible) {
      $range = [double]($h + $streamHeight)
      $y = [double](-1 * $streamHeight + (Get-Random -Minimum 0 -Maximum ([int]$range)))
    } else {
      # Spawn fully above the top by at least full stream height (respect per-stream font size)
      $y = -1 * ($streamHeight + (Get-Random -Minimum 0 -Maximum ([int]($h * 0.5))))
    }
    [System.Windows.Controls.Canvas]::SetTop($tb, [double]$y)

    [void]$DigitalRain.Children.Add($tb)

    $actualLines = ($tb.Text -split "`n").Length
    $stream = [pscustomobject]@{
      TB     = $tb
      X      = [double]$candX
      Y      = [double]$y
      Len    = [int]$actualLines
      # Faster overall speeds to reduce dead space
      Speed  = (Get-Random -Minimum 0.8 -Maximum 4.2)
      LineH  = $streamLineH
      Mutate = 0
    }
    $script:RainStreams += ,$stream
  }

  if ($script:RainTimer) { $script:RainTimer.Stop() }
  $script:RainTimer = New-Object System.Windows.Threading.DispatcherTimer
$script:RainTimer.Interval = [TimeSpan]::FromMilliseconds(16)  # ~60 FPS target
  $script:RainTimer.Add_Tick({ Update-DigitalRain })
  $script:RainTimer.Start()
}

function Update-DigitalRain {
  try {
    $h = [double]$DigitalRain.ActualHeight
    if ($h -le 0) { $h = [double]$window.ActualHeight }
    foreach ($s in $script:RainStreams) {
      $s.Y += $s.Speed
      if ($s.Y -lt ($h + ($s.Len * $s.LineH))) {
        [System.Windows.Controls.Canvas]::SetTop($s.TB, [double]$s.Y)
      } else {
        # Mixed lengths on reset: most short, some long
        $lenRoll  = Get-Random -Minimum 0 -Maximum 100
        if ($lenRoll -lt 70) {
          $tickers = Get-Random -Minimum 5 -Maximum 12
        } else {
          $tickers = Get-Random -Minimum 16 -Maximum 28
        }
        $s.TB.Text = (New-StreamTickers $tickers)
        $s.Len     = ($s.TB.Text -split "`n").Length
        $s.Speed = (Get-Random -Minimum 0.8 -Maximum 4.2)
        # Ensure full off-screen spawn so they always enter from top
        $streamHeight = [double]$s.LineH * [double]$s.Len
        $s.Y     = -1 * ($streamHeight + (Get-Random -Minimum 0 -Maximum ([int]($h * 0.5))))
        [System.Windows.Controls.Canvas]::SetTop($s.TB, [double]$s.Y)
      }

      $s.Mutate++
      if ($s.Mutate -ge 5) {
      $s.Mutate = 0
        $lines = $s.TB.Text -split "`n"
        if ($lines.Length -gt 0) {
          $idx = Get-Random -Minimum 0 -Maximum $lines.Length
          $lines[$idx] = (Get-RandomTicker)
          $s.TB.Text = [string]::Join("`n", $lines)
        }
      }
    }
  } catch {}
}

$window.Add_ContentRendered({ Init-DigitalRain })
$window.Add_SizeChanged({ Init-DigitalRain })
$window.Add_Closed({ if ($script:RainTimer) { $script:RainTimer.Stop() } })

function Open-Tabs([string]$Ticker) {
  if ($Ticker -notmatch '^[A-Z0-9]{1,10}$') {
    [System.Windows.MessageBox]::Show("Use 1-10 letters/numbers.","Invalid Ticker",'OK','Warning') | Out-Null
    return
  }

  # Always open a new window, then add background tabs to that window
  $y = ("https://finance.yahoo.com/quote/{0}" -f $Ticker)
  $z = ("https://www.zacks.com/stock/quote/{0}" -f $Ticker)
  $f = ("https://finviz.com/quote.ashx?t={0}" -f $Ticker)

  # Create the new window first (Yahoo focused)
  & $Firefox -P StockOpener -new-window $y
  Start-Sleep -Milliseconds 600

  # Then add the two tabs; they should land in the active (new) window
  & $Firefox -P StockOpener -new-tab $z
  Start-Sleep -Milliseconds 200
  & $Firefox -P StockOpener -new-tab $f

  # Finally bring that window to the foreground
  Start-Sleep -Milliseconds 250
  Focus-FirefoxWindow $Ticker
  
  # Start window watcher after we actually have Firefox windows
  try {
    if ($WindowWatchTimer -and -not $WindowWatchTimer.IsEnabled) { $WindowWatchTimer.Start() }
  } catch {}
}

# Enter opens; Esc clears
$TickerBox.Add_PreviewKeyDown({
  param($s,$e)
  if ($e.Key -eq 'Return' -or $e.Key -eq 'Enter') {
    $t = $TickerBox.Text.Trim()
    if ($t) { Open-Tabs $t; $TickerBox.Clear() }
    $e.Handled = $true
  } elseif ($e.Key -eq 'Escape') {
    $TickerBox.Clear()
    $e.Handled = $true
  }
})

# Button click does the same as Enter
$OpenBtn.Add_Click({
  $t = $TickerBox.Text.Trim()
  if ($t) { Open-Tabs $t; $TickerBox.Clear() }
})

# Show the window (modal)
$null = $window.ShowDialog()
