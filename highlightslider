# Defer CSV loading further using a background worker triggered later at low priority
function Start-DeferredCsvLoad {
  try {
    if ($script:_CsvLoadStarted) { return }
    $script:_CsvLoadStarted = $true
    $csvTimer = New-Object System.Windows.Threading.DispatcherTimer
    $csvTimer.Interval = [TimeSpan]::FromMilliseconds(2400)
    $csvTimer.Add_Tick({ param($s,$e)
      try { $s.Stop() } catch {}
      try {
        $bw = New-Object System.ComponentModel.BackgroundWorker
        $bw.Add_DoWork({ param($sender,$args)
          try {
            $desktop = [Environment]::GetFolderPath('Desktop')
            $spPath  = Join-Path $desktop 'SP500.csv'
            $allPath = Join-Path $desktop 'all_us_stocks.csv'
            $spText  = $null; $allText = $null
            try { if (Test-Path $spPath)  { $spText  = [System.IO.File]::ReadAllText($spPath) } } catch {}
            try { if (Test-Path $allPath) { $allText = [System.IO.File]::ReadAllText($allPath) } } catch {}
            $spArr  = @(); $allArr = @()
            if ($spText)  { $spArr  = Convert-CsvTextToTickersFixed $spText }
            if ($allText) { $allArr = Convert-CsvTextToTickersFixed $allText }
            $args.Result = [pscustomobject]@{ Sp=$spArr; All=$allArr }
          } catch { $args.Result = $null }
        })
        $bw.Add_RunWorkerCompleted({ param($sender,$args)
          try {
            $data = $args.Result
            if ($data -ne $null) {
              $sp  = $data.Sp
              $all = $data.All
              if (-not $sp  -or $sp.Count  -lt 10) { $sp  = @('AAPL','MSFT','GOOGL','AMZN','NVDA','META','TSLA','BRK.B','UNH','XOM','JNJ','JPM','V','PG') }
              if (-not $all -or $all.Count -lt 10) { $all = @('AAPL','MSFT','GOOGL','AMZN','NVDA','META','TSLA','BRK.B','UNH','XOM','JNJ','JPM','V','PG') }
              $script:Sp500Tickers = $sp
              $script:AllTickers   = $all
              $script:Tickers      = ($sp + $all | Select-Object -Unique)
              $script:DeferTickerLoad = $false
            }
          } catch {}
        })
        $bw.RunWorkerAsync() | Out-Null
      } catch {}
    })
    $csvTimer.Start()
  } catch {}
}

