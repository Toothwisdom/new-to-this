  param([double]$ToOpacity)
  try {
    if (-not $DigitalRain) { return }
    $from = [double]$DigitalRain.Opacity
    $to   = if ($PSBoundParameters.ContainsKey('ToOpacity')) { [double]$ToOpacity } else { [double]$script:RainTargetOpacity }
    if ($to -lt 0.0) { $to = 0.0 }
    $anim = New-Object System.Windows.Media.Animation.DoubleAnimation
    $anim.From = $from
    $anim.To   = $to
    $anim.Duration = New-Object System.Windows.Duration ([TimeSpan]::FromMilliseconds(160))
    $DigitalRain.BeginAnimation([System.Windows.UIElement]::OpacityProperty, $anim)
  } catch {}
}


function Continue-RainBuild {
  try {
    if (-not $script:_RainBuild) { return }
    $start = [int]$script:_RainBuild.Next
    $end = [int]([Math]::Min($start + $script:_RainBuild.Chunk, $script:_RainBuild.Cols))
    if ($end -gt $start) { Build-RainStreamsBatch -start $start -end $end }
    $script:_RainBuild.Next = $end
    if ($script:_RainBuild.Next -lt $script:_RainBuild.Cols) {
      $null = $window.Dispatcher.BeginInvoke([Action]{ Continue-RainBuild }, [System.Windows.Threading.DispatcherPriority]::ApplicationIdle)
    } else {
      $script:_RainBuild = $null
      Show-DigitalRain
    }
  } catch { $script:_RainBuild = $null }
}


