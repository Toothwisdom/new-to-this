$script:LastFxCount = 0
$WindowWatchTimer = New-Object System.Windows.Threading.DispatcherTimer
$WindowWatchTimer.Interval = [TimeSpan]::FromMilliseconds(400)
$WindowWatchTimer.Add_Tick({
