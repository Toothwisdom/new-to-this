# Load XAML into WPF
$reader = New-Object System.Xml.XmlNodeReader $xaml
$window = [Windows.Markup.XamlReader]::Load($reader)

# Layout/text rendering tweaks for smoother, cheaper drawing
try { $window.UseLayoutRounding = $true } catch {}
try { [System.Windows.Media.TextOptions]::SetTextFormattingMode($window, [System.Windows.Media.TextFormattingMode]::Display) } catch {}
try { [System.Windows.Media.TextOptions]::SetTextRenderingMode($window, [System.Windows.Media.TextRenderingMode]::Grayscale) } catch {}

# (Startup non-blocking) We will prompt to close Firefox only when opening a ticker

   
$TitleBar    = $window.FindName('TitleBar')
$MinBtn      = $window.FindName('MinBtn')
$CloseBtn    = $window.FindName('CloseBtn')
$TickerBox   = $window.FindName('TickerBox')
$OpenBtn     = $window.FindName('OpenBtn')
$CaretCanvas = $window.FindName('CaretCanvas')
$BlockCaret  = $window.FindName('BlockCaret')
$DigitalRain = $window.FindName('DigitalRain')
try { [System.Windows.Media.TextOptions]::SetTextFormattingMode($DigitalRain, [System.Windows.Media.TextFormattingMode]::Display) } catch {}
try { [System.Windows.Media.TextOptions]::SetTextRenderingMode($DigitalRain, [System.Windows.Media.TextRenderingMode]::Grayscale) } catch {}
try { $DigitalRain.CacheMode = New-Object System.Windows.Media.BitmapCache } catch {}
$HLSlider   = $window.FindName('HLSlider')
$HLValue    = $window.FindName('HLValue')

# Apply highlight density to existing runs
function Update-HighlightDensity {
  try {
    $prob = [int]$script:HighlightProb
    foreach ($s in $script:RainStreams) {
      if (-not $s -or -not $s.Runs) { continue }
      for ($i=0; $i -lt $s.Runs.Length; $i++) {
        $r = $s.Runs[$i]
        if (-not $r) { continue }
        $roll = Get-FastRandomInt 0 100
        if ($roll -lt $prob) {
          $r.Foreground = $script:BrushBright
          $r.FontWeight = 'Bold'
        } else {
          $r.Foreground = $script:BrushDim
          $r.FontWeight = 'Normal'
        }
      }
    }
  } catch {}
}

# Wire slider to control highlight probability
try {
  if ($HLSlider) {
    $HLSlider.Value = [double]$script:HighlightProb
    if ($HLValue) { $HLValue.Text = ([int][Math]::Round($HLSlider.Value)).ToString() }
    $HLSlider.Add_ValueChanged({ param($s,$e)
      try {
        $script:HighlightProb = [int][Math]::Round($HLSlider.Value)
        if ($HLValue) { $HLValue.Text = $script:HighlightProb.ToString() }
        Update-HighlightDensity
      } catch {}
    })
  }
} catch {}
# Block caret overlay support
function Update-BlockCaret {
  try {
    $rect = $TickerBox.GetRectFromCharacterIndex($TickerBox.CaretIndex, $true)
    if ($rect -ne $null -and $CaretCanvas) {
      $pt   = $TickerBox.TranslatePoint([System.Windows.Point]::new([double]$rect.X, [double]$rect.Y), $CaretCanvas)
      [System.Windows.Controls.Canvas]::SetLeft($BlockCaret, [double]$pt.X)
      [System.Windows.Controls.Canvas]::SetTop($BlockCaret,  [double]$pt.Y)
      $BlockCaret.Height = [double]$rect.Height
    }
  } catch {}
}
$TickerBox.Add_TextChanged({ Update-BlockCaret })
$TickerBox.Add_SelectionChanged({ Update-BlockCaret })
$TickerBox.Add_SizeChanged({ Update-BlockCaret })
$window.Add_ContentRendered({ Update-BlockCaret })
# Focus the input when the window shows
$window.Add_SourceInitialized({ $TickerBox.Focus() })

# Custom title bar behavior: drag, minimize, close
if ($TitleBar) {
  $TitleBar.Add_MouseLeftButtonDown({ param($s,$e) try { $window.DragMove() } catch {} })
}
if ($MinBtn)   { $MinBtn.Add_Click({ $window.WindowState = 'Minimized' }) }
if ($CloseBtn) { $CloseBtn.Add_Click({ $window.Close() }) }

# Uppercase & strip spaces live
$TickerBox.Add_TextChanged({
  $TickerBox.Text = ($TickerBox.Text -replace '\s','').ToUpper()
  $TickerBox.CaretIndex = $TickerBox.Text.Length
})

