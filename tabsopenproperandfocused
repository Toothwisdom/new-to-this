        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="STOCK TICKER OPENER"
                   Foreground="#00FF7F" FontFamily="Consolas"
                   FontSize="22" FontWeight="Bold" />

        <TextBlock Grid.Row="2"
                   Text="Type a ticker and press Enter. Yahoo opens focused; Zacks and Finviz open in background tabs."
                   Foreground="#66FFB3" FontFamily="Consolas" FontSize="13"
                   Opacity="0.9" TextWrapping="Wrap" />

        <!-- Input Row -->
        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="> "
                     Foreground="#00FF66" FontFamily="Consolas" FontSize="18"
                     VerticalAlignment="Center"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
            <TextBox x:Name="TickerBox"
                     Background="#000000" BorderBrush="#0F3A1F" BorderThickness="1.5"
                     Padding="10,6,10,6" Margin="0,0,10,0"
                     Foreground="#00FF66" CaretBrush="Transparent"
                     FontFamily="Consolas" FontSize="18"
                     MaxLength="10"
                     ToolTip="Enter ticker and press Enter."
                     HorizontalContentAlignment="Left"
                     VerticalContentAlignment="Center">
              <TextBox.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00FF66" Opacity="0.25"/>
              </TextBox.Effect>
            </TextBox>
            <!-- Overlay blinking block caret aligned to real caret -->
            <Canvas x:Name="CaretCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
              <Rectangle x:Name="BlockCaret" Width="8" Height="22" Fill="#00FF66" Opacity="0.0">
                <Rectangle.Triggers>
