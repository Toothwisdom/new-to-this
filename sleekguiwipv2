# Load XAML into WPF
$reader = New-Object System.Xml.XmlNodeReader $xaml
$window = [Windows.Markup.XamlReader]::Load($reader)

try { Ensure-StockOpenerInstance } catch { Write-Warning $_ }

   
$TitleBar    = $window.FindName('TitleBar')
$MinBtn      = $window.FindName('MinBtn')
$CloseBtn    = $window.FindName('CloseBtn')
$TickerBox   = $window.FindName('TickerBox')
$OpenBtn     = $window.FindName('OpenBtn')
$CaretCanvas = $window.FindName('CaretCanvas')
$BlockCaret  = $window.FindName('BlockCaret')
# Block caret overlay support
function Update-BlockCaret {
  try {
    $rect = $TickerBox.GetRectFromCharacterIndex($TickerBox.CaretIndex, $true)
    if ($rect -ne $null -and $CaretCanvas) {
      $pt   = $TickerBox.TranslatePoint([System.Windows.Point]::new([double]$rect.X, [double]$rect.Y), $CaretCanvas)
      [System.Windows.Controls.Canvas]::SetLeft($BlockCaret, [double]$pt.X)
      [System.Windows.Controls.Canvas]::SetTop($BlockCaret,  [double]$pt.Y)
      $BlockCaret.Height = [double]$rect.Height
    }
  } catch {}
}
$TickerBox.Add_TextChanged({ Update-BlockCaret })
$TickerBox.Add_SelectionChanged({ Update-BlockCaret })
$TickerBox.Add_SizeChanged({ Update-BlockCaret })
$window.Add_ContentRendered({ Update-BlockCaret })
# Focus the input when the window shows
$window.Add_SourceInitialized({ $TickerBox.Focus() })

# Custom title bar behavior: drag, minimize, close
if ($TitleBar) {
  $TitleBar.Add_MouseLeftButtonDown({ param($s,$e) try { $window.DragMove() } catch {} })
}
if ($MinBtn)   { $MinBtn.Add_Click({ $window.WindowState = 'Minimized' }) }
if ($CloseBtn) { $CloseBtn.Add_Click({ $window.Close() }) }

# Uppercase & strip spaces live
$TickerBox.Add_TextChanged({
  $TickerBox.Text = ($TickerBox.Text -replace '\s','').ToUpper()
  $TickerBox.CaretIndex = $TickerBox.Text.Length
})

# Watch Firefox windows: when one closes, refocus the next window below
$script:LastFxCount = (Get-FirefoxWindows).Count
$WindowWatchTimer = New-Object System.Windows.Threading.DispatcherTimer
$WindowWatchTimer.Interval = [TimeSpan]::FromMilliseconds(400)
$WindowWatchTimer.Add_Tick({
  try {
    $current = (Get-FirefoxWindows).Count
    if ($script:LastFxCount -gt $current -and $current -gt 0) {
      # A Firefox window closed; bring the next one to foreground
      Focus-TopFirefoxWindow | Out-Null
    }
    $script:LastFxCount = $current
  } catch {}
})
$WindowWatchTimer.Start()

function Open-Tabs([string]$Ticker) {
  if ($Ticker -notmatch '^[A-Z0-9]{1,10}$') {
    [System.Windows.MessageBox]::Show("Use 1-10 letters/numbers.","Invalid Ticker",'OK','Warning') | Out-Null
    return
  }

  # Always open a new window, then add background tabs to that window
  $y = ("https://finance.yahoo.com/quote/{0}" -f $Ticker)
  $z = ("https://www.zacks.com/stock/quote/{0}" -f $Ticker)
  $f = ("https://finviz.com/quote.ashx?t={0}" -f $Ticker)

  # Create the new window first (Yahoo focused)
  & $Firefox -P StockOpener -new-window $y
  Start-Sleep -Milliseconds 600

  # Then add the two tabs; they should land in the active (new) window
  & $Firefox -P StockOpener -new-tab $z
  Start-Sleep -Milliseconds 200
  & $Firefox -P StockOpener -new-tab $f

  # Finally bring that window to the foreground
  Start-Sleep -Milliseconds 250
  Focus-FirefoxWindow $Ticker
}

# Enter opens; Esc clears
$TickerBox.Add_PreviewKeyDown({
  param($s,$e)
  if ($e.Key -eq 'Return' -or $e.Key -eq 'Enter') {
    $t = $TickerBox.Text.Trim()
    if ($t) { Open-Tabs $t; $TickerBox.Clear() }
    $e.Handled = $true
  } elseif ($e.Key -eq 'Escape') {
    $TickerBox.Clear()
    $e.Handled = $true
  }
})

# Button click does the same as Enter
$OpenBtn.Add_Click({
  $t = $TickerBox.Text.Trim()
  if ($t) { Open-Tabs $t; $TickerBox.Clear() }
})

# Show the window (modal)
$null = $window.ShowDialog()
